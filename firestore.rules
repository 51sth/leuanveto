rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Kaikki nykyiset ja tulevat Oma liikunta -sovellukset.
    // Jokainen dokumentti on polun /users/{userId}/... alla.
    // Käyttäjä saa käsitellä vain oman tunnuksensa dokumentteja.
    match /users/{userId}/{document=**} {
      allow read, write: if request.auth != null
        && request.auth.uid == userId;
    }
  }
}
